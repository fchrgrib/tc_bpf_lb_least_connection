# Keep the build context small. Both images build from the repo root:
#   - tc-loader  needs libbpf/bpftool/vmlinux/bpf
#   - map-sync   needs go/ + bpf/fentry
# so we only drop heavy/unneeded trees and all build outputs here.
.git/
.gitmodules
.idea/
.vscode/
build/
bin/
**/.output/
**/target/
**/*.o
**/*.d
blazesym/target/
vmlinux.h/docs/
