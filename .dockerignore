# Keep the build context small. tc-loader / active-conn / map-sync images
# build from the repo root and need: lib/ (libbpf, vmlinux.h) and the
# relevant bpf/ subtree. tracker builds from bpf/user_space only.
# So we only drop heavy/unneeded trees and all build outputs here.
.git/
.gitmodules
.idea/
.vscode/
build/
bin/
**/.output/
**/target/
**/*.o
**/*.d
lib/blazesym/target/
lib/vmlinux.h/docs/
